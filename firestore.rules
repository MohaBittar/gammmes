rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    const isAdmin = request.auth != null
      && request.auth.token.email == "admin12345678@gmail.com";

    match /games/{gameId} {
      // anyone can browse and play
      allow read: if true;

      // only the admin can add or remove games
      allow create, delete: if isAdmin;

      // admin can edit anything; visitors may only bump the play counter by 1
      allow update: if isAdmin
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(["plays"])
            && request.resource.data.plays == resource.data.plays + 1);
    }

    // deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
